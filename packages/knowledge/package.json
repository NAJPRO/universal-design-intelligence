{
  "name": "@udi/knowledge",
  "version": "0.1.0",
  "private": true,
  "description": "Curated, attributed design knowledge for UDI",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./legacy": {
      "types": "./dist/legacy.d.ts",
      "import": "./dist/legacy.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./component-schemas": {
      "types": "./dist/component-schemas.d.ts",
      "import": "./dist/component-schemas.js"
    },
    "./v21-schemas": {
      "types": "./dist/v21-schemas.d.ts",
      "import": "./dist/v21-schemas.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/validate-catalog.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.12"
  }
}
